{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xiic Book Studio",
  "version": "0.1.0",
  "identifier": "com.xiic.book-studio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xiic Book Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 1120,
        "minHeight": 740
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/models/bge-small-zh-v1.5/**/*",
      "resources/web-search-mcp/service/**/*",
      "resources/web-search-mcp/runtime/**/*",
      "resources/web-search-mcp/node_modules/playwright/**/*",
      "resources/web-search-mcp/node_modules/playwright-core/**/*",
      "resources/web-search-mcp/browsers/**/*",
      "resources/web-search-mcp/xiic-manifest.json",
      "resources/web-search-mcp/LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
