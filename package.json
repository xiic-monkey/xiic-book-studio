{
  "name": "xiic-book-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite --host 127.0.0.1",
    "dev:visible": "node scripts/dev-visible.mjs",
    "tauri": "tauri",
    "build": "npm run contracts:check && tsc && vite build",
    "contracts:generate": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin generate_contracts",
    "contracts:check": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --bin generate_contracts -- --check",
    "test": "vitest run",
    "prepare:local-search": "node scripts/prepare-local-search-resources.mjs",
    "prepare:web-search": "node scripts/prepare-web-search-mcp.mjs",
    "bundle:prepare": "npm run prepare:local-search && npm run prepare:web-search",
    "tauri:build": "npm run bundle:prepare && tauri build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tanstack/react-query": "^5.85.5",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
